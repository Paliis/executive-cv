{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/cv",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "executive-cv.vercel.app" }],
      "destination": "https://parshentsev-cv.vercel.app/$1",
      "permanent": true
    }
  ]
}
