{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "executive-cv.vercel.app" }],
      "destination": "https://parshentsev-cv.vercel.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "TelegramBot (like TwitterBot)"
        }
      ],
      "destination": "/telegram.html"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "user-agent", "value": "Telegram" }],
      "destination": "/telegram.html"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "user-agent", "value": "facebookexternalhit" }],
      "destination": "/telegram.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/telegram.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/share.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
