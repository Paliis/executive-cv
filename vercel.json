{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "executive-cv.vercel.app" }],
      "destination": "https://parshentsev-cv.vercel.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/cv", "destination": "/index.html" }
  ]
}
